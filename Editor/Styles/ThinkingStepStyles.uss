/* Thinking Panel Styles */
.thinking-panel {
    background-color: var(--aifam-surface-raised);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--aifam-border);
    border-bottom-color: var(--aifam-border);
    border-left-color: var(--aifam-border);
    border-right-color: var(--aifam-border);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px;
}

.thinking-panel-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.thinking-panel-title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--aifam-text-secondary);
}

.thinking-panel-expand-button {
    width: 20px;
    height: 20px;
    padding: 0;
    margin-left: 8px;
}

.thinking-panel-summary {
    font-size: 11px;
    color: var(--aifam-text-faint);
    margin-bottom: 4px;
}

.thinking-panel-progress {
    height: 2px;
    background-color: var(--aifam-border);
    border-radius: 1px;
    margin-bottom: 8px;
    width: 100%;
}

.thinking-panel-steps {
    flex-direction: column;
}

/* Thinking Step Styles */
.thinking-step {
    background-color: var(--aifam-surface-sunken);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--aifam-surface);
    border-bottom-color: var(--aifam-surface);
    border-left-color: var(--aifam-surface);
    border-right-color: var(--aifam-surface);
    border-radius: 3px;
    padding: 6px;
    margin-bottom: 4px;
}

.thinking-step--pending {
    opacity: 0.6;
}

.thinking-step--in-progress {
    border-color: var(--aifam-accent);
}

.thinking-step--completed {
    border-color: var(--aifam-success);
}

.thinking-step--error {
    border-color: var(--aifam-error);
}

.thinking-step-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.thinking-step-status-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
}

.thinking-step-status-icon--in-progress {
    background-color: var(--aifam-accent-subtle);
    border-radius: 50%;
    /* animation not supported in Unity UI Toolkit - use C# code for rotation instead */
}

/* @keyframes not supported in Unity UI Toolkit - removed */

.thinking-step-status-icon--completed {
    color: var(--aifam-success);
}

.thinking-step-status-icon--error {
    color: var(--aifam-error);
}

.thinking-step-title {
    flex-grow: 1;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--aifam-text-secondary);
}

.thinking-step-duration {
    font-size: 10px;
    color: var(--aifam-text-faint);
    margin-left: 8px;
}

.thinking-step-details {
    font-size: 10px;
    color: var(--aifam-text-secondary);
    margin-top: 4px;
    margin-left: 22px;
}

.thinking-step-files {
    margin-top: 4px;
    margin-left: 22px;
}

.thinking-step-files-header {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--aifam-text-muted);
    margin-bottom: 2px;
}

.thinking-step-file-item {
    font-size: 10px;
    color: var(--aifam-text-faint);
    margin-left: 8px;
    margin-bottom: 2px;
}

.thinking-step-dependencies {
    margin-top: 4px;
    margin-left: 22px;
}

.thinking-step-dependencies-header {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--aifam-text-muted);
    margin-bottom: 2px;
}

.thinking-step-dependency-item {
    font-size: 10px;
    color: var(--aifam-error);
    margin-left: 8px;
    margin-bottom: 2px;
}

.thinking-step-progress-container {
    height: 2px;
    background-color: var(--aifam-surface);
    border-radius: 1px;
    margin-top: 4px;
    margin-left: 22px;
}

.thinking-step-progress-bar {
    height: 100%;
    background-color: var(--aifam-accent);
    border-radius: 1px;
}

