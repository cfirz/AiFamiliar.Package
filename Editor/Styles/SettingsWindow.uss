/* SettingsWindow.uss — TabView + section-header styling for the AI Familiar Settings window.
   Layered on top of AiFamiliarWindow.uss; both are loaded onto the settings window root. */

/* Window root override (already set by .ai-familiar-window in the main USS, repeated here
   for clarity since this window has different padding requirements). */
.ai-familiar-window.settings-window {
    background-color: var(--aifam-bg-root);
}

/* Window title */
.settings-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--aifam-text-primary);
    margin-bottom: 10px;
}

/* Section header (replaces inline styles set in AddSectionHeader) */
.settings-section-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--aifam-accent);
    margin-top: 14px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--aifam-surface);
}

/* Note / hint text under a section header */
.settings-note {
    color: var(--aifam-text-muted);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 10px;
}

/* Status footer label */
.settings-status-label {
    margin-top: 10px;
    font-size: 11px;
    color: var(--aifam-text-muted);
}

/* Project Map status label (overridden inline by C# for STALE / OK colors) */
.settings-project-map-status {
    margin-bottom: 8px;
    white-space: normal;
    font-size: 11px;
}

/* ────────────────────────────────────────────────────────────────────
   TabView — Unity 6 native element. The main USS .ai-familiar-window
   Button rule paints tab headers dark-on-dark and hides their labels,
   so we explicitly force visible text colors here. We deliberately do
   NOT override tab background or padding — Unity's defaults work.
   ──────────────────────────────────────────────────────────────────── */

.ai-familiar-window TabView {
    flex-grow: 1;
}

/* Tab header text — force bright on every nested element, regardless of
   whether Unity 6 implements the label as a Label, TextElement, or styled
   Button. The wildcard descendant selectors are intentional — but scoped
   strictly to the tab HEADER, not the tab content (which holds form labels). */
.ai-familiar-window .unity-tab__header,
.ai-familiar-window .unity-tab__header *,
.ai-familiar-window .unity-tab__header-label,
.ai-familiar-window .unity-tab-view__header-container,
.ai-familiar-window .unity-tab-view__header-container * {
    color: var(--aifam-text-primary);
}

/* The per-tab ScrollView gets a tiny inset so content doesn't hug the tab strip */
.ai-familiar-window .settings-tab-scroll {
    padding-top: 12px;
    padding-left: 8px;
    padding-right: 8px;
    flex-grow: 1;
}

/* Project Memory / lessons button row */
.ai-familiar-window .settings-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    margin-bottom: 15px;
}

.ai-familiar-window .settings-button-row Button {
    height: 26px;
    margin-right: 8px;
}

/* Project map generate / clear row */
.ai-familiar-window .settings-project-map-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.ai-familiar-window .settings-project-map-generate-button {
    height: 28px;
    margin-right: 8px;
    flex-grow: 1;
}

.ai-familiar-window .settings-project-map-clear-button {
    height: 28px;
    width: 100px;
}

/* Bottom Close button row */
.ai-familiar-window .settings-close-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
    flex-shrink: 0;
}

.ai-familiar-window .settings-close-button {
    width: 100px;
    height: 28px;
    margin-right: 15px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}
