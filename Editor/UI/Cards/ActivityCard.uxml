<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="activity-card" class="activity-card">
        <ui:VisualElement name="header" class="activity-card__header">
            <ui:VisualElement name="icon" class="activity-card__icon" />
            <ui:Label name="title" class="activity-card__title" />
            <ui:VisualElement name="state-badge-slot" class="activity-card__badge-slot" />
            <ui:Label name="timer" class="activity-card__timer" />
            <ui:Label name="chevron" class="activity-card__chevron" text="&#x25BE;" />
        </ui:VisualElement>
        <ui:VisualElement name="body" class="activity-card__body" />
    </ui:VisualElement>
</ui:UXML>
